{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCDH",
  "version": "0.1.0",
  "identifier": "com.xiaobo.mcdh",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCDH · MCDevHelper",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "xiaobo121388",
    "category": "DeveloperTool",
    "shortDescription": "离线管理网易中国版 Minecraft PE 创作组件",
    "externalBin": ["binaries/mcdh-mcp"],
    "resources": [
      "release-resources/README.md",
      "release-resources/THIRD_PARTY_LICENSES.md"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
